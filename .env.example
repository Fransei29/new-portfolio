# Copiar a .env.local y completar. .env.local NO se commitea.

# --- Resend (obligatorio para contacto y newsletter) ---
# API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remitente. El dominio tiene que estar verificado en Resend o los envíos fallan.
RESEND_FROM_EMAIL="Franco Seiler <hola@francoseiler.com>"

# Dónde llegan los mensajes del formulario de contacto.
CONTACT_INBOX=seilerfranco317@gmail.com

# --- Newsletter ---
# ID de la audiencia: https://resend.com/audiences
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secreto para firmar los tokens de confirmación y baja.
# Generar con: openssl rand -base64 32
# Si cambia, los enlaces de confirmación pendientes dejan de validar.
NEWSLETTER_SECRET=
